# Browser-accessible backend URL. For development on the same machine:
VITE_CONVEX_URL=http://127.0.0.1:3210
# Set only when using managed Convex; leave unset for self-hosting.
CONVEX_DEPLOYMENT=
# CLI-only: generate this admin key on your self-hosted backend. Never expose it to browsers.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Backend-only AI configuration. AI_BASE_URL includes /v1, not /chat/completions.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=
AI_API_KEY=
# Explicit opt-in for a local model server without authentication.
AI_ALLOW_NO_KEY=true
AI_TIMEOUT_MS=45000

# Optional browser-accessible Frankfurter-v2-compatible rates endpoint.
# Leave empty to disable external rate requests, or use a local endpoint.
VITE_FX_RATES_URL=
VITE_FX_SOURCE_URL=
VITE_FX_SOURCE_LABEL=
