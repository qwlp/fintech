# Used only by bun run deploy:local. Never commit .env.self-hosted.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
VITE_CONVEX_URL=http://127.0.0.1:3210
# The script generates and saves CONVEX_SELF_HOSTED_ADMIN_KEY automatically.

# Use an installed model that supports tool calling.
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=
AI_API_KEY=
# true only for a private, intentionally unauthenticated local model service.
AI_ALLOW_NO_KEY=true
AI_TIMEOUT_MS=45000
